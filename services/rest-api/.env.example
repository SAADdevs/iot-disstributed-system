# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- InfluxDB ----
# Fl Docker Compose: smiyat service (influxdb), machi localhost
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=change_me
INFLUX_ORG=iot-org
INFLUX_BUCKET=iot-bucket
INFLUX_MEASUREMENT=sensors
# ---- Business rules ----
# Sensor ykon "active" ila sift mesure f akhir X dqayeq
SENSOR_ACTIVE_MINUTES=5

